root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.rs]
indent_style = tab
tab_width = 4

[*.{toml,json,yml,yaml}]
indent_style = tab
tab_width = 2

[.sqlx/*.json]
# SQLx files should still use spaces as they're machine-generated
# and need to be consistent with SQLx's output
indent_style = space
indent_size = 2