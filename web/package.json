{
	"name": "funban-webapp",
	"version": "1.0.1",
	"private": true,
	"scripts": {
		"contracts:sync": "test -f ../contracts/ws_actions.json || (echo '❌ Contracts not found! Run: cd ../server && cargo build' && exit 1) && mkdir -p ./src/contracts && cp ../contracts/*.json ./src/contracts/ && echo '✅ Contracts synced successfully'",
		"contracts:test": "jest src/__tests__/contracts/",
		"predev": "yarn contracts:sync",
		"prebuild": "yarn contracts:sync",
		"pretest": "yarn contracts:sync",
		"dev": "next dev",
		"build": "next build",
		"start": "next start",
		"check:ts": "yarn contracts:sync && tsc --project tsconfig.json --pretty --noEmit",
		"check:lint": "yarn contracts:sync && eslint . --ext .js,.jsx,.ts,.tsx",
		"check:lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:coverage": "jest --coverage"
	},
	"dependencies": {
		"@emotion/cache": "^11.13.1",
		"@emotion/react": "^11.13.0",
		"@emotion/styled": "^11.13.0",
		"@mui/icons-material": "7.3.2",
		"@mui/material": "7.3.2",
		"@mui/material-nextjs": "7.3.2",
		"@tanstack/react-query": "^5.51.23",
		"@tanstack/react-query-devtools": "^5.51.23",
		"date-fns": "^4.1.0",
		"next": "15.5.2",
		"next-auth": "^4.24.7",
		"react": "^19",
		"react-dom": "19.1.1",
		"react-hook-form": "^7.52.2",
		"react-hotkeys-hook": "^5.0.1",
		"zod": "^4.1.11",
		"zustand": "^4.5.5"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.1.0",
		"@eslint/js": "^9.15.0",
		"@testing-library/dom": "^10.4.1",
		"@testing-library/jest-dom": "^6.8.0",
		"@testing-library/react": "^16.3.0",
		"@testing-library/user-event": "^14.6.1",
		"@types/jest": "^30.0.0",
		"@types/node": "24.3.1",
		"@types/react": "19.1.12",
		"@types/react-dom": "19.1.9",
		"@typescript-eslint/eslint-plugin": "^8.42.0",
		"@typescript-eslint/parser": "^8.42.0",
		"eslint": "^9.15.0",
		"eslint-config-next": "15.5.2",
		"jest": "^30.1.3",
		"jest-environment-jsdom": "^30.1.2",
		"prettier": "3.3.3",
		"typescript": "^5"
	},
	"packageManager": "yarn@4.9.4"
}
